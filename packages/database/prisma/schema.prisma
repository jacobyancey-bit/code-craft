generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  TECH
  ADMIN
}

enum ProjectStatus {
  DRAFT
  PENDING_DEPOSIT
  OPEN_FOR_CLAIM
  OPEN
  CLAIMED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

model User {
  id                     String        @id @default(uuid())
  email                  String        @unique
  name                   String?
  role                   Role          @default(CLIENT)
  activeJobs             Int           @default(0)
  stripeCustomerId       String?
  defaultPaymentMethodId String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  // Relations
  techUnlocks            TechUnlock[]
  clientProjects         Project[]     @relation("ClientProjects")
  claimedProjects        Project[]     @relation("TechProjects")
  timeLogs               TimeLog[]

  @@map("users")
}

model TechUnlock {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       String
  category    String
  unlockedAt  DateTime @default(now())

  @@unique([userId, skill, category])
  @@index([userId])
  @@map("tech_unlocks")
}

model Project {
  id                     String        @id @default(uuid())
  title                  String
  description            String?
  category               String
  status                 ProjectStatus @default(PENDING_DEPOSIT)

  // Rules and configuration snapshot
  appliedRulesSnapshot   Json

  // Hour bounds & rates
  minEstimatedHours      Float
  maxEstimatedHours      Float
  hourlyRateCents        Int           @default(8000)
  hardCapHours           Float

  // Funded and consumed hours
  fundedHours            Float         @default(0)
  consumedHours          Float         @default(0)

  // Stripe & Billing info
  stripeCustomerId       String?
  defaultPaymentMethodId String?
  stripePaymentIntentId  String?

  // 15-minute claim hold fields
  claimedById            String?
  claimedBy              User?         @relation("TechProjects", fields: [claimedById], references: [id])
  claimHoldStartedAt     DateTime?
  claimHoldExpiresAt     DateTime?
  isClaimConfirmed       Boolean       @default(false)

  // Client ownership
  clientId               String
  client                 User          @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)

  // Time logging
  timeLogs               TimeLog[]

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([clientId])
  @@index([claimedById])
  @@index([status])
  @@index([category])
  @@map("projects")
}

model TimeLog {
  id                    String    @id @default(uuid())
  projectId             String
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  techId                String
  tech                  User      @relation(fields: [techId], references: [id], onDelete: Cascade)

  hours                 Float
  notes                 String?
  gitCommitHash         String?

  // Auto-approval flags
  isAutoApproved        Boolean   @default(false)
  autoApprovalTriggered Boolean   @default(false)
  autoApprovedAt        DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([projectId])
  @@index([techId])
  @@map("time_logs")
}
